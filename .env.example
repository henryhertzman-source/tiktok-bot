# Kopiera till .env och fyll i. Lägg ALDRIG upp .env på GitHub (den står i .gitignore).

# --- Läge ---
# true = "Godkänn" publicerar inget, bara visar vad som skulle hända
DRY_RUN=true

# --- Discord (notiser + godkännande). Se README steg 3 ---
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# --- Livekoll. Twitch: dev.twitch.tv/console/apps. Kick: kick.com -> Settings -> Developer ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# valfri: bara för att läsa YouTube-chatten
YOUTUBE_API_KEY=

# --- Publicering ---
# auto = gratisläget (du laddar upp själv i TikTok) tills Post for Me-nyckel och konton finns
# manual = alltid gratisläget, postforme = alltid Post for Me
PUBLISH_MODE=auto

# --- Post for Me (valfritt, kostar). Kör `python -m clipbot accounts` för att få konto-id:n ---
POSTFORME_API_KEY=
# kommaseparerade, t.ex. TikTok-kontot och YouTube-kontot
POSTFORME_ACCOUNT_IDS=

# --- Claude (valfritt: skriver bildtexter; utan nyckel används en mall) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Inspelning ---
# hur ofta plattformarna tillfrågas
POLL_INTERVAL_SEC=120
# 10-minutersbitar, som i videon
CHUNK_SECONDS=600
STREAM_QUALITY=720p60,720p,best
# false = gamla bitar raderas när de är analyserade (sparar disk)
KEEP_RECORDINGS=false
DATA_DIR=data
STREAMERS_FILE=streamers.json

# --- Klipp och analys ---
# så här långt före toppen börjar klippet (videon: 35–45 s)
CLIP_PRE_SEC=40
CLIP_POST_SEC=15
# högre = färre men säkrare klipp
SCORE_THRESHOLD=2.5
MAX_CLIPS_PER_CHUNK=3
MIN_GAP_SEC=60
WEIGHT_CHAT=1.0
WEIGHT_EMOTES=1.5
WEIGHT_AUDIO=1.0
HYPE_EMOTES=KEKW,LUL,LULW,OMEGALUL,LMAO,LOL,HAHA,ICANT,Pog,PogChamp,POGGERS,W,monkaS,EZ,Clap,😂,🤣,💀,😭,🔥,😱
# 9:16 med suddig bakgrund för TikTok/Shorts/Reels
VERTICAL=true
